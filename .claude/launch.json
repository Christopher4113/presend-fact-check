{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "presend_check.server:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "api-claude",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "LLM_PROVIDER=anthropic",
        "uv",
        "run",
        "uvicorn",
        "presend_check.server:app",
        "--port",
        "8000"
      ],
      "port": 8000
    }
  ]
}